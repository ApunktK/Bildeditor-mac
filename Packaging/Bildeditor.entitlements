<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Vorerst ohne App-Sandbox: freier Dateizugriff (Bilder öffnen/speichern überall, Plugins später).
	     Hardened Runtime ist im Build aktiv (Voraussetzung für Notarisierung). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
